# --- GitHub App credentials (all required) -------------------------------------
# GitHub App settings → General (see README "Create the GitHub App")
APP_ID=123456
# The private key .pem file contents. Literal \n escapes are fine.
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# A random string you set when creating the app; used to verify webhooks.
WEBHOOK_SECRET=change-me-to-something-random

# --- GitHub Enterprise (optional; leave unset for github.com) ------------------
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Server ---------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- LLM provider (any OpenAI-compatible server; all required but API key) ------
# OpenAI:            https://api.openai.com/v1
# Ollama (local):    http://localhost:11434/v1
# vLLM (local):      http://localhost:8000/v1
# LM Studio (local): http://localhost:1234/v1
# Groq:              https://api.groq.com/openai/v1
# OpenRouter:        https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:7b

# --- LLM / review tuning (optional) ---------------------------------------------
# How the reviewer talks to your model:
#   ai-sdk            (default) Vercel AI SDK. Enables the tool-calling agent.
#   openai-compatible Plain fetch client. Single-shot reviews only, no tools.
# LLM_PROVIDER=ai-sdk
# LLM_TIMEOUT_MS=120000
# LLM_MAX_TOKENS=4096
# Set to false if your provider rejects response_format (rare)
# LLM_JSON_MODE=true
# MAX_FILES=30
# MAX_DIFF_CHARS=120000
# Set to false to disable check-runs (requires Checks: Read & write permission when on)
# CHECKS_ENABLED=true

# --- Agent (tool calling; requires LLM_PROVIDER=ai-sdk) -------------------------
# Let the model read full files, search the repo, and check history before
# committing to findings. Set to false for single-shot reviews.
# AGENT_TOOLS_ENABLED=true
# Hard ceiling on model <-> tool round trips per review.
# AGENT_MAX_STEPS=10

# --- Jev decision layer (TypeSafe AI) ------------------------------------------
# Get a key at https://console.typesafe.ai/settings/keys.
# With a key set, Jev routes PR complexity to a model, scores finding confidence
# (dropping weak ones), and independently validates severity.
# Without a key the reviewer still works, just without those decisions.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# JEV_ENABLED=true
# Drop findings whose Jev confidence (0-100) is below this.
# JEV_CONFIDENCE_THRESHOLD=60
# JEV_TIMEOUT_MS=10000

# --- Feedback learning (SQLite) -------------------------------------------------
# Records findings we post and how developers respond, then feeds the lessons
# back into future prompts. Uses Node's built-in node:sqlite — no native build.
# Requires Node 23.4+ (or 22.5+ with --experimental-sqlite); on older runtimes
# the store logs a warning and disables itself.
# FEEDBACK_ENABLED=true
# FEEDBACK_DB_PATH=./data/feedback.sqlite
