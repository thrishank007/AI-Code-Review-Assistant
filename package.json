{
  "name": "ai-pr-reviewer",
  "version": "0.1.0",
  "description": "Self-hosted GitHub App that reviews pull requests with your own OpenAI-compatible LLM. Like CodeRabbit, but yours.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "review:pr": "tsx scripts/review-pr.ts",
    "eval": "tsx evals/src/cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "octokit": "^3.1.0",
    "pino": "^9.4.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  }
}
